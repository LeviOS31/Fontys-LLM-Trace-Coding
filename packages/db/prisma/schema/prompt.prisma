enum PromptType {
  AXIAL_CODE_GENERATION_SYSTEM
  AXIAL_CODE_GENERATION_USER
  AXIAL_CODE_REGENERATION_SYSTEM
  AXIAL_CODE_REGENERATION_USER
  LLM_AS_A_JUDGE_STATIC_SYSTEM
  LLM_AS_A_JUDGE_STATIC_USER
  LLM_AS_A_JUDGE_GENERATION_SYSTEM
  LLM_AS_A_JUDGE_GENERATION_USER
  LLM_AS_A_JUDGE_SCRATCH_SYSTEM
  LLM_AS_A_JUDGE_SCRATCH_USER
  AI_FEEDBACK_SUGGESTION_SYSTEM
  AI_FEEDBACK_SUGGESTION_USER
}

model Prompt {
  id          String   @id @unique @default(uuid())
  text        String
  promptType PromptType @unique
}
