{
  "name": "webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check",
    "docker:up": "docker compose -f ../../backend/Dbcompose.yaml up -d",
    "docker:down": "docker compose -f ../../backend/Dbcompose.yaml down",
    "docker:reset": "docker compose -f ../../backend/Dbcompose.yaml down -v && docker compose -f ../../backend/Dbcompose.yaml up -d"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/themes": "3.3.0",
    "@tanstack/react-query": "5.96.1",
    "@visx/group": "4.0.0-alpha.11",
    "@visx/responsive": "4.0.0-alpha.11",
    "@visx/shape": "4.0.0-alpha.11",
    "lucide-react": "1.7.0",
    "prism": "^4.1.2",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.8.0",
    "react-router": "7.13.2",
    "react-syntax-highlighter": "^16.1.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@eslint/js": "9.39.4",
    "@rolldown/plugin-babel": "0.2.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.12.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cypress": "15.13.0",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "29.0.1",
    "pg": "8.20.0",
    "prettier": "3.8.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.57.2",
    "vite": "8.0.6",
    "vitest": "4.1.1"
  }
}
